<!DOCTYPE html>
<html>
    <head>
        <script>
            function registerUser(){
                let username
                let pass
                while (username=="" || username==undefined || username==null){
                    username=prompt("Enter your name:")
                }
                while (pass==null || pass==undefined || pass.length<8){
                    pass=prompt("Enter 8-digit password:")
                }
                let data=confirm("Are you sure you want to register with this username and password?")
                if (data==true){
                    alert("Successfully registraed by "+username+" and "+pass)
                }
                else{
                    alert("Registration Canceled.")
                }
            }
        </script>
    </head>
    <body>
        <input type="button" value="register button" onclick="registerUser()">
    </body>
</html>

