<!DOCTYPE html>
<html>
    <head>
        <script>
            const students = [
                { name: 'Alice', scores: { math: 85, science: 90, history: 78 } },
                { name: 'Bob', scores: { math: 92, science: 88, history: 95 } },
                { name: 'Charlie', scores: { math: 70, science: 75, history: 80 } },
                { name: 'Diana', scores: { math: 95, science: 98, history: 93 } }
            ];
            function topstudent(){
                let fobj={}
                let maxavg=0;
                for (const s of students){
                    const avg=(s.scores.math+s.scores.science+s.scores.history)/3;
                    if (avg>maxavg){
                        maxavg=avg
                        fobj={
                            name: s.name , 
                            average: avg.toFixed(2)
                        };
                    }
                }
            return fobj;
            }
            const tops=topstudent(students);
            console.log(tops)
        </script>
    </head>
</html>

