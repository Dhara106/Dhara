<!DOCTYPE html>
<html>
    <body>
        <button onclick="fun()">Get JOKE</button>
        <p id="a"></p>
        <script>
            function fun(){
                fetch("https://official-joke-api.appspot.com/random_joke")
                .then(res=>res.json())
                .then(data=>{
                    document.getElementById('a').innerHTML=data.setup+"<br>"+data.punchline
                })
                .catch(error=>{
                    console.log("error",error)
                })
            }
        </script>
    </body>
</html>

