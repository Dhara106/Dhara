<!DOCTYPE html>
<!-- write a function that results a promise which resolves a number after 1 sec use a loop with async to get values from 1 to 3 print the double number of each value -->
<html>
    <body>
        <script>
            function gd(num){
                return new Promise((resolve)=>{
                    setTimeout(()=>{
                        resolve(num)
                    },1000)
                })
            }
            async function fd(){
                for(let i=0;i<=3;i++){
                    let value=await gd(i)
                    console.log(value*2)
                }
            } 
            fd()
        </script>
    </body>
</html>

