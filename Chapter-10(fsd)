<!DOCTYPE html>
<html>
    <body>
        <script>
            function gd(){
                return new Promise((resolve,reject)=>{
                    setTimeout(()=>{
                        let success=true
                        if(success){
                            resolve('order complete')
                        }
                        else{
                            reject('order cancel')
                        }
                    },5000)
                    console.log('Processing')
                })
            }
            async function fd(){
                console.log('waiting')
                try{
                    let result=await gd()
                    console.log(result)
                }
                catch(err){
                    console.log('error',err)
                }
            }
            fd()
        </script>
    </body>
</html>

