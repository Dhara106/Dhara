<!DOCTYPE html>
<!-- write a js to validate username and password; password length must be of 6 to 12 char; 
 username should not start with _,@ and any number. Both the field must not be blanked -->
<html>
    <body>
        Username: <input type="text" id="u1">
        <br>
        Password: <input type="password" id="p1">
        <br>
        <input type="submit" onclick="fun()">
        <script>
            function fun(){
                user=/^_|^@|^\d/
                //gmail=/^\w+@\w+(\.\w{2,3})+$/
                z=document.getElementById('u1').value
                y=document.getElementById('p1').value
                if(y.length==0 || z.length==0){
                    alert("Can't blank")
                }
                else if(y.length<6 || y.length>12){
                    alert("Password must between 6 to 12")
                }
                else if(y[0]=='@' || y[0]=='_' ){
                    alert("password not start with @ and _")
                }
                else{
                    alert("Password is strong")
                }
                if(user.test(z)){
                    alert("Enter valid username")
                }
            }
        </script>
    </body>
</html>
