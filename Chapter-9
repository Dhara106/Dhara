        <script>
            function fun2(e){
                let val=e.button
                switch(val){
                    case 0: alert('Left click') 
                        break
                    case 1: alert('Center click')
                        break
                    case 2: alert('Right click')
                        break
                    default: alert('Something went wrong')
                        break
                }
            }
        </script>
