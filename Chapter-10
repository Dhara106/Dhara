<!DOCTYPE html>
<html>
    <body>
        Enter your phone number:- 
        <input type="text" id="pn">
        <input type="submit" onclick="fun()">
        <script>
            function fun(){
                pno=/^\d{10}$/
                //for one char only == /^\w\D{1}/
                u=document.getElementById("pn").value
                if(pno.test(u)){
                    alert('Perfect '+u)
                }
                else{
                    alert("Enter proper phone number")
                }
            }
        </script>
    </body>
</html>

