<!DOCTYPE html>
<!-- design a log in form with following validation in password field: min number of password is 8 letters 
and it must have some special character -->
<html>
    <body>
        <input type="text" id="p1">
        <input type="submit" onclick="fun()">
        <script>
            function fun(){
                pass=/\w{8,}/
                u=document.getElementById('p1').value
                if(pass.test(u)){
                    alert('Perfect '+u)
                }
                else{
                    alert("Enter correct password")
                }
            }
        </script>
    </body>
</html>

